# Conexión a la base de datos
DATABASE_URL="postgresql://postgres:123admin@localhost:5432/timeprotection_db?schema=public"

# Clave para encriptar las cookies de sesión
SESSION_SECRET="encriptacookies"

# Puerto del servidor
PORT=3000