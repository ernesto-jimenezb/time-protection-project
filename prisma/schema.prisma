generator client {
  provider = "prisma-client-js"
  // ELIMINAMOS la línea 'output', para usar la ubicación por defecto
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}